// Generated by CMake from the repository's git state - do not edit.
// See the "Build number" block in CMakeLists.txt.

#pragma once

// The build counter on its own, for anywhere that wants just the number. It goes
// up by one on every build: cmake/bump_build.cmake stamps this file, and the
// launcher's build depends on that stamping having run. See the "Build number"
// block in CMakeLists.txt.
#define MW2_BUILD_NUMBER L"@MW2_BUILD_NUMBER@"

// The build's date, in the local time of whoever built it.
#define MW2_BUILD_DATE L"@MW2_BUILD_DATE@"

// The short form, which is what the window shows beside the buttons:
//     build 41   2026-10-02
#define MW2_BUILD_TEXT L"@MW2_BUILD_TEXT@"

// The long form, with the commit hash and a + when the tree was dirty:
//     build 41 (c7080db+, 2026-10-02)
#define MW2_BUILD_LONG L"@MW2_BUILD_LONG@"
